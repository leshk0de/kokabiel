#!/bin/sh /etc/rc.common
# Kokabiel: prepare the capture NIC at boot (one-shot, not a daemon).
# shellcheck disable=SC2034 # START/USE_PROCD are read by rc.common
START=19
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command "${KOKABIEL_LIBEXEC:-/usr/libexec/kokabiel}/capture-prep"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
