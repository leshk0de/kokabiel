#!/bin/sh /etc/rc.common
# Kokabiel: softflowd flow exporter under procd (respawned if it dies).
# shellcheck disable=SC2034 # START/USE_PROCD are read by rc.common
START=60
USE_PROCD=1

start_service() {
	_lib=${KOKABIEL_LIBEXEC:-/usr/libexec/kokabiel}
	# shellcheck disable=SC1091
	. "$_lib/common.sh"
	# shellcheck disable=SC1091
	. "$_lib/flows.sh"
	_cmd=$(kk_flows_cmdline) || return 1
	procd_open_instance
	# shellcheck disable=SC2086 # argv is space-separated by construction
	procd_set_param command $_cmd
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
