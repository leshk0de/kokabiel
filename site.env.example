# Kokabiel site configuration. Copy to site.env (gitignored) and edit.
# Placeholders in <...> are rejected until you replace them.

# REQUIRED. IP or hostname of the NetFlow/IPFIX collector.
COLLECTOR_HOST=<COLLECTOR_IP>
# UDP port the collector listens on.
COLLECTOR_PORT=2055
# Export format: 10 = IPFIX (default), 9 = NetFlow v9.
EXPORT_VERSION=10

# Interface receiving the mirrored traffic (promiscuous, no IP).
CAPTURE_IF=eth1
# Management interface (SSH, metrics, collector export).
MGMT_IF=eth0
# Optional: probe name; sets the hostname and distinguishes probes at the collector.
PROBE_NAME=

# Where packet captures are stored (SD card mount point).
CAPTURE_DIR=/mnt/kokabiel-cap
# Cap on SD capture storage, in MB.
CAPTURE_SD_MAX_MB=4096
# Cap on RAM (tmpfs) capture, in MB. Allowed 100-500.
CAPTURE_RAM_MAX_MB=100

# Keep the local web UI (LuCI) enabled, bound to 127.0.0.1 only: 0 or 1.
ENABLE_LUCI=0

# Optional remote syslog; empty SYSLOG_HOST turns it off.
SYSLOG_HOST=
SYSLOG_PORT=514
SYSLOG_PROTO=udp

# Source address/CIDR allowed to scrape metrics on TCP 9100.
# Empty = the management interface's IPv4 subnet, computed at setup time.
METRICS_ALLOWED_SRC=

# softflowd tracking level: full, proto, ip, or ether (adds MAC addresses).
TRACK_LEVEL=full
